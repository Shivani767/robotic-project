<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_ci_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch entry point for the ROBOT CI Panda pick-and-place episode over ROS 2.
    Starts the policy node and the simulation node as two separate processes and
    wires them by the topics defined in robot_ci.ros2.topics.
  </description>
  <maintainer email="noreply@example.com">Robotics CI contributors</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_ci_adapters</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
